{
  "name": "kingdom-under-fire",
  "version": "0.1.0",
  "private": true,
  "description": "Banni\u00e8res de Cendre : RTS m\u00e9di\u00e9val-fantastique 3D original (Three.js + TypeScript) \u2014 batailles de masse, formations, h\u00e9ros",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "bench": "vitest run --project bench --silent=false",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
